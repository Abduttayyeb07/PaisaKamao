# =============================================================================
# Copy to .env and fill in. On a server, keep this file next to
# docker-compose.yml - compose loads it via `env_file: .env`.
# chmod 600 .env  (it holds your signing key and bot token)
# =============================================================================

# --- Chain endpoints -------------------------------------------------------
# RPC_BASE is the Tendermint WebSocket. "/websocket" is appended automatically.
RPC_BASE=wss://zigchain-mainnet-rpc-sanatry-01.wickhub.cc
# HTTP_RPC is used for broadcasting swaps and for simulation.
HTTP_RPC=https://zigchain-mainnet-rpc-sanatry-01.wickhub.cc

# --- Pool / denoms ---------------------------------------------------------
POOL_CONTRACT=zig1h72z8ptvcdqvuvy2lqanupwtextjmjmktj2ejgne2padxk0z8zds48shzq
STZIG_DENOM=coin.zig109f7g2rzl2aqee7z6gffn8kfe9cpqx0mjkk7ethmx8m2hq4xpe9snmaam2.stzig
UZIG_DENOM=uzig
STZIG_EXP=6
UZIG_EXP=6

# --- Wallet ----------------------------------------------------------------
# Leave PRIVATE_KEY empty to run in dry-run mode: the bot watches the pool and
# logs "[BUY]/[SELL] dry run: missing PRIVATE_KEY, swap skipped." but never
# broadcasts. Set it only when you want the bot to trade real funds.
# Format: 32-byte hex (64 hex chars), no 0x prefix.
PRIVATE_KEY=
# The zig1... address matching PRIVATE_KEY. Shown on the dashboard.
WALLET_ADDRESS=

# --- Fees ------------------------------------------------------------------
FEE_DENOM=uzig
GAS_PRICE=0.025

# --- Price band ------------------------------------------------------------
# Band shown on the dashboard and used to normalise the strategy gauge.
BUY_ZIG_TO=1.038
SELL_STZIG_FROM=0.991
# Band used by the execution/sizing code in trade-hooks.ts. Keep these in sync
# with the two above unless you intend them to differ.
UPPER_TARGET=1.038
LOWER_TARGET=0.991

# --- Execution -------------------------------------------------------------
# Minimum gap between two trades, milliseconds.
COOLDOWN_MS=10000
# EMA factor applied to the raw pool ratio. 0 = no smoothing, 1 = no history.
PRICE_SMOOTHING_ALPHA=0.25
# Multiplier applied to each zone's sizeZig. 1 = use the configured size.
TRADE_UNIT=1
# Max acceptable slippage as a fraction (0.002 = 0.2%).
MAX_SLIPPAGE=0.002
# Size orders from an on-chain simulation instead of a fixed amount.
USE_SIM_SIZING=true
# Fallback order size in ZIG when USE_SIM_SIZING=false.
FIXED_TRADE_ZIG=1
# Verbose simulation logging.
DEBUG_SIM=false

# --- Telegram (optional) ---------------------------------------------------
# Leave blank to disable notifications.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Dashboard -------------------------------------------------------------
# LOCAL RUNS ONLY. Do not set these in a server .env used with Docker:
# docker-compose.yml already forces DASHBOARD_HOST=0.0.0.0 so the published
# port works, and setting 127.0.0.1 here would be ignored anyway.
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=3030

# --- State file paths ------------------------------------------------------
# Do NOT set these in a server .env. The Docker image points them at /app/data,
# which is the mounted volume; overriding them here would write to a
# non-persistent, non-writable location inside the container.
# TRADE_LOG_FILE=trade-history.log
# TRADE_CSV_FILE=trade-actions.csv
# ZONE_STATE_FILE=zone-state.json
# SUBSCRIBERS_FILE=subscribers.csv
